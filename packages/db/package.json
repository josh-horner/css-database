{
  "name": "@css/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed-cli.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed-cli.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@css/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@css/config": "workspace:*",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@css/integrations": "workspace:*"
  }
}
