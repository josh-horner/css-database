# Copy to .env. Never put real credentials in .env.example.

# Local dev database from docker-compose.yml (fake data only).
DATABASE_URL=postgres://css:css@localhost:5544/css_dev

# Public URLs (the crew tablet and phones need a LAN or tunnel address, not localhost).
API_URL=http://localhost:4100
PORTAL_URL=http://localhost:4102
ADMIN_URL=http://localhost:4101

# Signs tracking/pay links and staff sessions. Any long random string.
APP_SECRET=change-me-to-a-long-random-string

# Payments: "fake" works offline; "stripe" uses a Stripe TEST account.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# SMS: leave Twilio blank to log messages to the console instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email: leave blank to log to the console. Otherwise Amazon SES in the CSS AWS account.
SES_REGION=
EMAIL_FROM=CSS <hello@example.com>

# AI first response to customer messages. Blank = a simple rules-based fake.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Demo: route one seeded customer's texts to a real phone (E.164, e.g. +13035550123).
DEMO_CUSTOMER_PHONE=
# Bearer token the crew tablet pairs with (seeded).
DEMO_DEVICE_TOKEN=dev-tablet-token
